// Ints, floats, strings, null and bools mixed in + - * / % and the comparisons
var show = function(name, f) {
	try $print(name, " = ", f(), " ", $typeof(f()), "\n") catch e $print(name, " throws ", e, "\n");
};

var values = $array(0, 1, -3, 2.5, -0.5, 1073741823, 0x7FFFFFFF, "7", "ab", "", null, true, false, 1.0);
var names = $array("0", "1", "-3", "2.5", "-0.5", "max31", "max32", "\"7\"", "\"ab\"", "\"\"", "null", "true", "false", "1.0");
var ops = $array(
	function(a, b) a + b,
	function(a, b) a - b,
	function(a, b) a * b,
	function(a, b) a / b,
	function(a, b) a % b
);
var opnames = $array("+", "-", "*", "/", "%");
var cmps = $array(
	function(a, b) a == b,
	function(a, b) a != b,
	function(a, b) a < b,
	function(a, b) a <= b,
	function(a, b) a > b,
	function(a, b) a >= b
);
var cmpnames = $array("==", "!=", "<", "<=", ">", ">=");

var i = 0;
while i < $asize(values) {
	var j = 0;
	while j < $asize(values) {
		var a = values[i];
		var b = values[j];
		var k = 0;
		$print(names[i], " ? ", names[j], ":");
		while k < $asize(ops) {
			var r = try ops[k](a, b) catch e "!";
			$print(" ", opnames[k], " ", r);
			k += 1;
		}
		k = 0;
		$print(" |");
		while k < $asize(cmps) {
			$print(" ", cmpnames[k], " ", cmps[k](a, b));
			k += 1;
		}
		$print("\n");
		j += 1;
	}
	i += 1;
}

show("1 + 2.0", function() 1 + 2.0);
show("1.5 + 1.5", function() 1.5 + 1.5);
show("0.1 + 0.2", function() 0.1 + 0.2);
show("\"a\" + 1 + 2", function() "a" + 1 + 2);
show("1 + 2 + \"a\"", function() 1 + 2 + "a");
show("\"x\" + null", function() "x" + null);
show("null + \"x\"", function() null + "x");
show("\"x\" + 1.5", function() "x" + 1.5);
show("\"x\" + $array(1,2)", function() "x" + $array(1, 2));
show("\"x\" + true", function() "x" + true);
show("1 - \"a\"", function() 1 - "a");
show("null + 1", function() null + 1);
show("true + 1", function() true + 1);
show("5.5 % 2", function() 5.5 % 2);
show("-5.5 % 2", function() -5.5 % 2);
show("5 % 2.5", function() 5 % 2.5);
show("2.5 * 4", function() 2.5 * 4);
show("10 / 4", function() 10 / 4);
show("max32 + 0.5", function() 0x7FFFFFFF + 0.5);
show("max31 + 1 + 0.5", function() 1073741823 + 1 + 0.5);
show("int32 * 1.0", function() 0x40000000 * 1.0);
show("int32 / int32", function() 0x40000000 / 0x40000000);
show("int32 % 7", function() 0x40000001 % 7);
show("int32 - int31", function() 0x40000000 - 1);
show("int32 == 1073741824.0", function() 0x40000000 == 1073741824.0);
show("int32 < int32", function() 0x40000000 < 0x40000001);
show("int32 == int32", function() 0x40000000 == 0x40000000);
show("1 < 1.5", function() 1 < 1.5);
show("\"10\" < \"9\"", function() "10" < "9");
show("\"abc\" < \"abd\"", function() "abc" < "abd");
show("\"ab\" < \"abc\"", function() "ab" < "abc");
show("\"\\200\" > \"a\"", function() "\200" > "a");
show("2 < \"10\"", function() 2 < "10");
show("null < 1", function() null < 1);
show("null == null", function() null == null);
show("true == true", function() true == true);
show("true < false", function() true < false);
