// The order neko evaluates operands, call arguments, array and object literals, and
//  field and index assignments; nekoc writes version 1 modules, where arrays are built
//  with MakeArray
log = "";
var t = function(name, v) { log += name; v };
var f3 = function(a, b, c) a + b + c;
$print("call ", f3(t("a", 1), t("b", 2), t("c", 3)), " ", log, "\n");
log = "";
$print("array ", $array(t("a", 1), t("b", 2), t("c", 3), t("d", 4)), " ", log, "\n");
log = "";
$print("binop ", t("l", 10) - t("r", 3), " ", log, "\n");
log = "";
$print("nested ", (t("a", 1) + t("b", 2)) * (t("c", 3) - t("d", 4)), " ", log, "\n");
log = "";
var o = $new(null);
t("obj", o).field = t("val", 5);
$print("field set ", o.field, " ", log, "\n");
log = "";
var arr = $amake(3);
t("arr", arr)[t("idx", 1)] = t("val", 7);
$print("index set ", arr, " ", log, "\n");
log = "";
var lit = { a => t("a", 1), b => t("b", 2), c => t("c", 3) };
$print("object literal ", lit, " ", log, "\n");
log = "";
var m = $new(null);
m.go = function(x, y) x * y;
$print("method ", t("target", m).go(t("x", 6), t("y", 7)), " ", log, "\n");
log = "";
$print("and ", t("a", false) && t("b", true), " ", log, "\n");
log = "";
$print("or ", t("a", true) || t("b", true), " ", log, "\n");
log = "";
$print("builtin args ", $sblit($smake(4), t("p", 0), t("s", "abcd"), t("q", 0), t("n", 4)), " ", log, "\n");
log = "";
var six = function(a, b, c, d, e, f) $array(a, b, c, d, e, f);
$print("six args ", six(t("1", 1), t("2", 2), t("3", 3), t("4", 4), t("5", 5), t("6", 6)), " ", log, "\n");
log = "";
var compare = t("l", 1) < t("r", 2);
$print("compare ", compare, " ", log, "\n");
log = "";
var big = $array(t("0", 0), t("1", 1), t("2", 2), t("3", 3), t("4", 4), t("5", 5), t("6", 6), t("7", 7), t("8", 8), t("9", 9));
$print("big array ", big, " ", log, "\n");
log = "";
var x = 1;
x += t("rhs", 2);
$print("compound ", x, " ", log, "\n");
log = "";
o.n = 1;
t("o", o).n += t("v", 10);
$print("compound field ", o.n, " ", log, "\n");
